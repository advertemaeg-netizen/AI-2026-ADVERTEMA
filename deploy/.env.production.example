# Copy to deploy/.env.production on the server and fill in real values.
# NEVER commit .env.production (it's gitignored).
#
# NEXT_PUBLIC_* are baked into the build: after changing one, rebuild
# (deploy/update.sh or `docker compose --env-file .env.production up -d --build`).
# The others are read at runtime: `docker compose --env-file .env.production up -d`
# is enough after changing them.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only: bypasses RLS for the public widget webhook and background jobs
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# --- Public URL of this app (webhook URLs, embed codes, invite links) ---
NEXT_PUBLIC_APP_URL=https://app.mudrik-ai.com

# --- AI provider ---
# Replies and lead analysis. REQUIRED: the container refuses to start without it
AI_PROVIDER=openai
# Knowledge-base embeddings. REQUIRED: the container refuses to start without
# it. Does not follow AI_PROVIDER: changing it means re-embedding every chunk
# first (vectors from two models aren't comparable).
AI_EMBEDDING_PROVIDER=openai

# --- Google Gemini ---
GOOGLE_GEMINI_API_KEY=REPLACE_ME
# Optional overrides (defaults: gemini-3.8-flash / gemini-3.5-flash-lite / gemini-embedding-001)
GOOGLE_GEMINI_MODEL=
GOOGLE_GEMINI_ANALYSIS_MODEL=
GOOGLE_GEMINI_EMBEDDING_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=REPLACE_ME
# Optional overrides (default: gpt-6-luna for both)
OPENAI_MODEL=
OPENAI_ANALYSIS_MODEL=
# The model the stored chunks were embedded with. REQUIRED with
# AI_EMBEDDING_PROVIDER=openai: the container refuses to start without it.
# Another model here still returns 1536-d vectors, so nothing fails —
# questions are just compared with another model's vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional, defaults to none (required for these models unless reasoning is off)
OPENAI_REASONING_EFFORT=

# Meta (WhatsApp Cloud API, Messenger, Instagram): the app's id, its secret (signs
# webhook deliveries) and the webhook verify token. META_APP_ID is what the
# subscribed_apps check compares against: a WABA not subscribed to this app
# delivers nothing, with no error anywhere.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
