# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by the public website-widget webhook to write
# conversations for anonymous visitors (bypasses RLS). Never expose it.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of this app, used to build channel webhook URLs and embed codes.
# Optional locally (falls back to the request host); set it in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider for replies and lead analysis: gemini or openai. REQUIRED, no
# default: the server refuses to start without it (instrumentation.ts).
AI_PROVIDER=openai
# AI provider for knowledge-base embeddings: gemini or openai. REQUIRED, no
# default: the server refuses to start without it (instrumentation.ts).
# Does NOT follow AI_PROVIDER. Changing it means re-embedding every stored
# chunk with the new provider first — vectors from two models aren't
# comparable, so a visitor's question embedded by one matches none of the
# other's chunks.
AI_EMBEDDING_PROVIDER=openai

# Google Gemini (AI replies for the website widget)
GOOGLE_GEMINI_API_KEY=
# Optional chat model, defaults to gemini-3.8-flash
GOOGLE_GEMINI_MODEL=
# Optional model for per-message lead detection, defaults to gemini-3.5-flash-lite
# (a separate model keeps it off the chat model's quota)
GOOGLE_GEMINI_ANALYSIS_MODEL=
# Optional, defaults to gemini-embedding-001 (text-embedding-004 is retired)
GOOGLE_GEMINI_EMBEDDING_MODEL=

# OpenAI (only with AI_PROVIDER=openai)
OPENAI_API_KEY=
# Optional chat and lead-analysis models, both default to gpt-6-luna
OPENAI_MODEL=
OPENAI_ANALYSIS_MODEL=
# Optional, defaults to none: these models only take the bot's temperature
# with reasoning off. Any other value drops the temperature.
OPENAI_REASONING_EFFORT=
# REQUIRED with AI_EMBEDDING_PROVIDER=openai, no default.
# Requested at 1536 dimensions (EMBEDDING_DIMENSIONS, src/lib/ai/provider.ts) to
# match knowledge_documents.embedding_1536. The stored chunks carry this
# model's vectors: another model means re-embedding them first.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# The site's contact form (mudrik-ai.com/contact) sends to contact@mudrik-ai.com over
# SMTP: the mailbox provider's own server. Without these the form always reports
# that it didn't send (and points at WhatsApp); it never claims a message it didn't send.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
# Only if the account sends as another address than CONTACT_SMTP_USER
CONTACT_SMTP_FROM=
